# ==============================================
# MAXEVA GESTION - Variables de Entorno
# ==============================================
# Copia este archivo como .env.local y completa los valores
# cp .env.example .env.local

# Supabase Configuration (REQUERIDO)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# OpenAI Configuration (opcional, para OCR y AI Copilot)
OPENAI_API_KEY=sk-proj-xxx

# Web Push Notifications - VAPID Keys (opcional)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_EMAIL=mailto:your-email@example.com

# Deshabilitar autenticación en desarrollo (SOLO para testing local)
# ADVERTENCIA DE SEGURIDAD: NUNCA setear esta variable fuera de NODE_ENV=development.
#   Si DISABLE_AUTH=true con cualquier otro NODE_ENV (production, staging, preview),
#   el servidor rechaza el arranque con un Error fatal (ver instrumentation.ts).
# DISABLE_AUTH=true

# Amadeus API — IATA airport/city search (opcional)
# Crear cuenta gratis en https://developers.amadeus.com
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=

# Geoapify Places API — fallback para búsqueda de hoteles por destino (opcional)
# Crear cuenta gratis en https://www.geoapify.com/pricing/
GEOAPIFY_API_KEY=

# ==============================================
# Mercado Pago — Suscripciones (preapproval)
# ==============================================
# Token de producción (cobra tarjetas reales):
MERCADOPAGO_ACCESS_TOKEN=
# Secret del webhook (firma HMAC-SHA256). Configurar en panel de MP:
MERCADOPAGO_WEBHOOK_SECRET=

# Opcional: sandbox de MP para E2E testing sin cobrar tarjetas reales.
# Cuando MP_USE_SANDBOX=true, la lib usa MERCADOPAGO_ACCESS_TOKEN_SANDBOX
# en vez del token de producción. Test cards:
# https://www.mercadopago.com.ar/developers/es/docs/checkout-api/integration-test/test-cards
MERCADOPAGO_ACCESS_TOKEN_SANDBOX=
MP_USE_SANDBOX=false

# ==============================================
# Emilia — búsquedas y cotizaciones automáticas
# ==============================================
EMILIA_API_URL=https://api.vibook.ai/v1/emilia/turn
# La API key se asigna por agencia en agency_emilia_credentials (encriptada).
EMILIA_OFFER_REFRESH_URL=https://api.vibook.ai/v1/offer-refresh
EMILIA_OFFER_REFRESH_TIMEOUT_MS=210000
QUOTATION_PRICE_REFRESH_REVIEW_TTL_SECONDS=900
# Acceso promocional para todos los planes hasta este instante. Después del
# corte sólo acceden ENTERPRISE y planes custom. ISO 8601, opcional.
EMILIA_PROMOTION_END_AT=2026-11-11T19:32:31.000Z
# Timeout de la llamada externa. Default: 65000 ms.
EMILIA_API_TIMEOUT_MS=65000

# ==============================================
# Paywall / App URL
# ==============================================
# URL pública de la app, usada para back_url de MP y mailto del admin.
# DEBE incluir https:// (si falta, la normalizamos en runtime).
NEXT_PUBLIC_APP_URL=https://app.vibook.ai

# Hosts HTTPS adicionales cuyas imágenes pueden congelarse dentro de PDFs de
# cotización. Lista de hostnames separados por coma, sin protocolo ni paths.
# Supabase y NEXT_PUBLIC_APP_URL se autorizan automáticamente.
QUOTATION_DOCUMENT_ASSET_HOSTS=

# Secret compartido con Railway cron services (Bearer auth).
CRON_SECRET=

# === Vibook integrations ===
# AES-256-GCM key for encrypting webhook secrets stored in integration_webhooks table.
# Generate locally with: openssl rand -hex 32
WEBHOOK_SECRET_ENCRYPTION_KEY=

# ==============================================
# Agente Blanco — embebido de Conversaciones (bandeja IG/WhatsApp)
# ==============================================
# Secreto compartido para firmar el JWT HS256 de /api/agente-blanco/token.
# SOLO backend: si termina en un bundle del cliente, cualquiera firma tokens
# para cualquier empresa habilitada. Lo entrega Agente Blanco por gestor de
# contraseñas o link de un solo uso (nunca por mail o chat).
# Al rotar, el secreto anterior sigue valiendo una semana: no hace falta corte.
AGENTE_BLANCO_SECRET=
# clientId que nos asigna Agente Blanco; viaja en el claim iss. Default: vibook
AGENTE_BLANCO_CLIENT_ID=vibook
# kid del secreto vigente, opcional. Va en el header del JWT y le sirve a Agente
# Blanco para saber cual de sus claves firmo cuando algo falla.
AGENTE_BLANCO_KEY_ID=
# Snippet del embebido. Cambiar solo para apuntar al staging de Agente Blanco.
NEXT_PUBLIC_AGENTE_BLANCO_EMBED_SRC=https://agenteblanco.com.ar/v1/embed.js

# Callbell API base URL (verify version against https://dev.callbell.eu/)
CALLBELL_API_BASE_URL=https://api.callbell.eu/v1.1

# ==============================================
# Linear — triage de tickets de soporte (bugs/mejoras → issues de dev)
# ==============================================
# API key personal/workspace (Linear → Settings → API → Personal API keys).
# Se envía tal cual en el header Authorization (sin "Bearer").
LINEAR_API_KEY=
# ID del team donde se crean los issues (Linear → Settings → API, o la URL del team).
LINEAR_TEAM_ID=
# Secret del webhook Linear → /api/webhooks/linear (firma HMAC-SHA256 del body).
# Configurar en Linear → Settings → API → Webhooks (evento Issues), URL:
# https://app.vibook.ai/api/webhooks/linear
LINEAR_WEBHOOK_SECRET=
# Label aplicado a TODOS los tickets de soporte para identificar los cargados
# por clientes desde el producto. Se resuelve/crea por NOMBRE (no ID). Default: "Cliente".
LINEAR_CLIENT_LABEL=Cliente
# Opcionales: IDs de labels a aplicar. Si faltan, el issue se crea sin ese label.
LINEAR_LABEL_BUG=
LINEAR_LABEL_IMPROVEMENT=
LINEAR_LABEL_SEV_LOW=
LINEAR_LABEL_SEV_MEDIUM=
LINEAR_LABEL_SEV_HIGH=
LINEAR_LABEL_SEV_CRITICAL=

# ==============================================
# Google Analytics 4 — telemetría de producto
# ==============================================
# Measurement ID del Web data stream (GA4 → Admin → Flujos de datos).
# OJO: las NEXT_PUBLIC_* se inlinean en BUILD TIME. Setearla en Railway sin
# redeployar no hace nada: el bundle queda con el string vacío y GA nunca carga.
# Setear y redeployar.
#
# Qué se manda: pageviews con la URL normalizada (los UUID pasan a :id y la query
# string se filtra por allowlist) y eventos de producto con parámetros
# categóricos. Identidad: user_id, org_id, rol y plan.
# Qué NO se manda nunca: email, nombre, nombre de agencia, montos, datos de
# clientes, teléfono, CUIT/DNI ni texto libre. Ver docs/architecture/analytics-ga4.md.
#
# Las vistas públicas /cotizacion/* quedan excluidas por diseño: las abren los
# clientes finales de la agencia, que no consintieron nada.
#
# Si la variable está vacía, no se carga ningún script de terceros.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Habilita GA fuera de producción y activa GA4 DebugView. Solo desarrollo local.
# Default: desactivado (cualquier valor distinto de "1").
NEXT_PUBLIC_GA_DEBUG=
